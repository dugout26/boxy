/* tokens.uss — Boxy Cozy Design Tokens (handoff-derived, 2026-04-30 v3)
 * 좌표계: 390×844 pt (iPhone 12+ base) — PanelSettings refRes에 직결.
 * 모든 USS 수치는 pt 단위로 작성 (1pt ≈ 1 reference px in UI Toolkit).
 * 출처: design/handoff/app_onboarding_v2/ui.jsx (T 객체) + mascot.jsx
 */

:root {
    /* Backgrounds */
    --bg-cozy: #FFF6EC;
    --bg-elevated: #FFFFFF;

    /* Accent (cozy orange — 메인 CTA / 강조) */
    --accent: #F59E4B;
    --accent-on: #FFFFFF;
    --accent-soft: #FFE4C8;
    --accent-deep: #D97A2B;

    /* Mascot (브랜드 보존 — yellow는 마스코트 본체에만) */
    --mascot-yellow: #FFD60A;
    --mascot-yellow-dark: #E5B800;
    --mascot-yellow-light: #FFE85C;

    /* Text (warm browns, 차가운 검정 X) */
    --text-primary: #3D2B1F;
    --text-secondary: #8B6F5C;

    /* Borders / Dividers */
    --border-soft: #F0E0CC;

    /* Semantic */
    --success: #7CB342;
    --warning: #F4A93D;
    --error: #E87764;

    /* Warm shadow tint (2-layer 그림자 패턴) */
    --shadow-warm: rgba(160, 90, 40, 0.12);
    --shadow-warm-strong: rgba(160, 90, 40, 0.22);
    --shadow-orange: rgba(217, 122, 43, 0.28);
    --shadow-orange-pressed: rgba(217, 122, 43, 0.30);

    /* Modal scrim (결과/광고 팝업 배경) */
    --scrim-modal: rgba(61, 43, 31, 0.65);
}

/* 공통 base */
.bg-cozy {
    background-color: #FFF6EC;
    flex-grow: 1;
}

.bg-elevated {
    background-color: #FFFFFF;
}

/* Typography utilities (Pretendard 가정) */
.txt-primary {
    color: #3D2B1F;
}

.txt-secondary {
    color: #8B6F5C;
}

.txt-accent {
    color: #F59E4B;
}

.txt-display {
    font-size: 44px;
    -unity-font-style: bold;
    letter-spacing: -2;
    color: #3D2B1F;
}

.txt-h1 {
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: -1;
    color: #3D2B1F;
}

.txt-h2 {
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: -1;
    color: #3D2B1F;
}

.txt-body-lg {
    font-size: 17px;
    color: #3D2B1F;
}

.txt-body {
    font-size: 15px;
    color: #3D2B1F;
}

.txt-caption {
    font-size: 13px;
    color: #8B6F5C;
}

.txt-center {
    -unity-text-align: middle-center;
}
