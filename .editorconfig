# CLAUDE.md §19-3 보완 — IDE/Roslyn 자동 적용 규칙

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4

# C# 스타일
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true

# §3-3 const 명명 — PascalCase
dotnet_naming_rule.const_pascal.severity = warning
dotnet_naming_rule.const_pascal.symbols  = const_symbols
dotnet_naming_rule.const_pascal.style    = pascal_style
dotnet_naming_symbols.const_symbols.applicable_kinds   = field
dotnet_naming_symbols.const_symbols.required_modifiers = const
dotnet_naming_style.pascal_style.capitalization        = pascal_case

# §3-1 데드코드 / 미사용 멤버
dotnet_diagnostic.IDE0051.severity = warning   # 미사용 private 멤버
dotnet_diagnostic.IDE0052.severity = warning   # 미사용 멤버 읽기/쓰기 X
dotnet_diagnostic.IDE0060.severity = warning   # 미사용 매개변수
dotnet_diagnostic.CS0168.severity  = error     # 미사용 변수
dotnet_diagnostic.CS0219.severity  = error     # 미사용 로컬 (할당만)
dotnet_diagnostic.CS0162.severity  = warning   # 도달 불가 코드

# §4-2 readonly 권장 (불변성)
dotnet_diagnostic.IDE0044.severity = warning   # readonly로 만들 수 있음
dotnet_style_readonly_field        = true:warning

# 명시적 타입 (var는 내장 타입에만)
csharp_style_var_for_built_in_types     = false:suggestion
csharp_style_var_when_type_is_apparent  = true:suggestion
csharp_style_var_elsewhere              = false:suggestion

# null 처리
dotnet_style_coalesce_expression                  = true:warning
dotnet_style_null_propagation                     = true:warning
dotnet_style_prefer_is_null_check_over_reference  = true:warning

# 표현식 본문
csharp_style_expression_bodied_methods       = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors  = false:suggestion
csharp_style_expression_bodied_properties    = when_on_single_line:suggestion

# §3-2 중복 — 정적 분석으로는 한계, 사람이 점검
# §6-1 public 컬렉션은 check-violations.sh가 잡음

# Unity 자동 생성 / 외부 코드는 제외
[Library/**]
generated_code = true

[Temp/**]
generated_code = true

[*.{json,asset,prefab,unity,meta,asmdef}]
indent_size = 2
trim_trailing_whitespace = false
