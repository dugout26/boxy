<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Mound/UI/Styles/tokens.uss" />
    <Style src="project://database/Assets/Mound/UI/Styles/components.uss" />

    <!-- handoff S4 Gameplay (screens-b.jsx GameplayScreen). -->
    <ui:VisualElement name="root" class="bg-cozy" style="flex-direction: column;">

        <!-- Top bar: back / level + progress + stars / hint + undo -->
        <ui:VisualElement style="flex-direction: row; align-items: center; padding: 14px 16px 14px 16px; border-bottom-width: 1px; border-bottom-color: #F0E0CC;">
            <!-- back-button: GameplayUI가 query하는 이름. pause 의미로도 쓰임. -->
            <ui:Button name="back-button" class="btn-icon-sm" text="뒤로" style="font-size: 11px; -unity-font-style: bold; color: #3D2B1F;" />

            <ui:VisualElement style="flex-grow: 1; flex-direction: column; align-items: center;">
                <ui:Label name="level-label" text="Level 1-1" style="font-size: 15px; -unity-font-style: bold; letter-spacing: -0.3px; color: #3D2B1F; margin-bottom: 4px;" />
                <ui:VisualElement class="progress-bg" style="width: 70%;">
                    <ui:VisualElement name="progress-fill" class="progress-fill" style="width: 0%;" />
                </ui:VisualElement>
                <!-- Stars (controller가 텍스트 ★/☆로 채움) -->
                <ui:VisualElement style="flex-direction: row; margin-top: 4px;">
                    <ui:Label name="star-1" text="☆" style="font-size: 14px; color: #F0E0CC; margin: 0 2px;" />
                    <ui:Label name="star-2" text="☆" style="font-size: 14px; color: #F0E0CC; margin: 0 2px;" />
                    <ui:Label name="star-3" text="☆" style="font-size: 14px; color: #F0E0CC; margin: 0 2px;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement style="flex-direction: row;">
                <ui:Button name="hint-button" class="btn-icon-sm" text="힌트" style="margin-right: 6px; font-size: 11px; -unity-font-style: bold; color: #F59E4B;" />
                <ui:Button name="undo-button" class="btn-icon-sm" text="취소" style="font-size: 11px; -unity-font-style: bold; color: #3D2B1F;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Canvas: 6×6 grid in brown leather frame. width 90%, aspect-ratio 1 (height auto-derive) -->
        <ui:VisualElement style="padding: 20px 20px 12px 20px; align-items: center;">
            <ui:VisualElement name="canvas-frame" style="width: 90%; max-width: 360px; aspect-ratio: 1; background-color: #8B5E2C; border-radius: 16px; padding: 8px;">
                <!-- grid-container는 absolute-positioned 셀들의 컨테이너 (GridCellView가 left/bottom으로 위치 잡음) -->
                <ui:VisualElement name="grid-container" style="flex-grow: 1; position: relative;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Item tray (horizontal scroll inside card) -->
        <ui:VisualElement style="padding: 8px 16px 12px 16px;">
            <ui:VisualElement class="card" style="padding: 12px;">
                <ui:ScrollView name="item-tray" mode="Horizontal" style="height: 100px;">
                    <ui:VisualElement style="flex-direction: row;" />
                </ui:ScrollView>
                <!-- Page dots -->
                <ui:VisualElement name="tray-dots" style="flex-direction: row; justify-content: center; margin-top: 8px;">
                    <ui:VisualElement class="step-dot step-dot-active" />
                    <ui:VisualElement class="step-dot" />
                    <ui:VisualElement class="step-dot" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bottom safe area buffer -->
        <ui:VisualElement style="height: 16px;" />

    </ui:VisualElement>
</ui:UXML>
