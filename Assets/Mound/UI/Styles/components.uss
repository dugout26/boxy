/* Mound Brand v2.0 — Component Styles */
/* mound-design-system.md §4 컴포넌트 명세 매핑 */
/* tokens.uss 먼저 import 필수 (UXML에서 두 USS 모두 적용) */

/* === Pretendard 글꼴 — 한국어 + 영어 통합 === */
/* mound-design-system.md §6: Pretendard 단일 폰트 (Inter 제거 -3~5MB 절약) */
/* Unity가 Assets/Mound/UI/Fonts/Pretendard-{Regular,Bold}.otf 자동 import 후 활성 */
:root {
    -unity-font-definition: url("project://database/Assets/Mound/UI/Fonts/Pretendard-Regular.otf");
}

/* === Button === */
.btn-primary {
    background-color: var(--accent);
    color: var(--on-accent);
    font-size: var(--text-body);
    -unity-font-style: bold;
    border-radius: var(--radius-button);
    height: 48px;
    padding: 0 var(--space-md);
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    transition: scale var(--duration-micro) ease-out;
}

.btn-primary:disabled {
    opacity: 0.4;
}

.btn-primary:active {
    scale: 0.97 0.97;
}

.btn-secondary {
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-primary);
    font-size: var(--text-body);
    -unity-font-style: normal;
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius-button);
    height: 48px;
    padding: 0 var(--space-md);
}

.btn-secondary:disabled {
    opacity: 0.4;
}

.btn-ghost {
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-secondary);
    font-size: var(--text-caption);
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    border-radius: var(--radius-button);
    height: 40px;
    padding: 0 var(--space-sm);
}

/* === Popup === */
.popup-overlay {
    position: absolute;
    background-color: var(--overlay);
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.popup-card {
    background-color: var(--surface);
    border-radius: var(--radius-popup);
    width: 80%;
    max-width: 320px;
    padding: var(--space-lg);
}

.popup-title {
    color: var(--text-primary);
    font-size: var(--text-h1);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: var(--space-sm);
}

.popup-body {
    color: var(--text-secondary);
    font-size: var(--text-body);
    -unity-text-align: middle-center;
    margin-bottom: var(--space-md);
    white-space: normal;
}

/* === Toast === */
.toast {
    position: absolute;
    bottom: 16px;
    background-color: rgba(26, 26, 26, 0.9);
    color: #FFFFFF;
    font-size: var(--text-caption);
    border-radius: var(--radius-toast);
    padding: 12px var(--space-md);
    align-self: center;
}

/* === ProgressBar === */
.progress-bar {
    height: 8px;
    border-radius: 4px;
    background-color: var(--border);
    overflow: hidden;
}

.progress-bar-fill {
    height: 100%;
    background-color: var(--accent);
    border-radius: 4px;
    transition: width var(--duration-page) ease-out;
}

/* === Toggle === */
.toggle {
    width: 48px;
    height: 28px;
    border-radius: 14px;
    background-color: var(--border);
    transition: background-color var(--duration-standard) ease-out;
    flex-direction: row;
    align-items: center;
    padding: 2px;
}

.toggle.on {
    background-color: var(--accent);
}

.toggle-knob {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background-color: #FFFFFF;
    transition: translate var(--duration-standard) ease-out;
}

.toggle.on > .toggle-knob {
    translate: 20px 0;
}

/* === Slider === */
.slider-track {
    height: 4px;
    border-radius: 2px;
    background-color: var(--border);
    flex-direction: row;
    align-items: center;
}

.slider-fill {
    height: 100%;
    background-color: var(--accent);
    border-top-left-radius: 2px;
    border-bottom-left-radius: 2px;
}

.slider-thumb {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background-color: var(--accent);
    border-width: 2px;
    border-color: #FFFFFF;
    position: absolute;
}

/* === Utility === */
.is-disabled {
    opacity: 0.4;
}

.text-display {
    font-size: var(--text-display);
    -unity-font-style: bold;
    color: var(--text-primary);
}

.text-h1 {
    font-size: var(--text-h1);
    -unity-font-style: bold;
    color: var(--text-primary);
}

.text-h2 {
    font-size: var(--text-h2);
    -unity-font-style: bold;
    color: var(--text-primary);
}

.text-body {
    font-size: var(--text-body);
    color: var(--text-primary);
}

.text-caption {
    font-size: var(--text-caption);
    color: var(--text-secondary);
}

.surface {
    background-color: var(--surface);
}

.bg-light {
    background-color: var(--bg);
}

/* === ScrollBar 숨기기 — UI Toolkit 기본 ScrollView가 표시하는 화살표/슬라이더 정리 === */
/* iPhone에서 Windows 95 스타일 ScrollBar 보이는 것 방지 */
.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}
.unity-scroller--vertical,
.unity-scroller--horizontal {
    width: 4px;
    background-color: transparent;
}
.unity-scroller--vertical .unity-base-slider__tracker,
.unity-scroller--horizontal .unity-base-slider__tracker {
    background-color: transparent;
}
.unity-scroller--vertical .unity-base-slider__dragger,
.unity-scroller--horizontal .unity-base-slider__dragger {
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 2px;
    border-width: 0;
}

/* === 게임플레이 모션 (decisions/2026-04-29-19-ui-motion.md) === */

/* 그리드 셀 — 드래그 hover 시 부드러운 highlight transition */
.grid-cell {
    transition: background-color var(--duration-micro) ease-out;
}

/* 아이템 카드 — 회전 시 0.97 scale (피드백) */
.item-card {
    transition: scale var(--duration-micro) ease-out;
}
.item-card:active {
    scale: 1.03 1.03;
}

/* 별 등장 애니메이션 — 클리어 시 stagger 등장 */
@keyframes star-pop {
    from { scale: 0 0; opacity: 0; }
    50% { scale: 1.2 1.2; opacity: 1; }
    to { scale: 1 1; opacity: 1; }
}
.star-animated {
    /* USS는 @keyframes 미지원 — C#에서 schedule.Execute로 처리 */
    transition: scale var(--duration-emphasis) ease-out, opacity var(--duration-emphasis) ease-out;
}
.star-animated-hidden {
    scale: 0 0;
    opacity: 0;
}
.star-animated-visible {
    scale: 1 1;
    opacity: 1;
}

/* 마스코트 bounce — 결과 popup 등장 시 */
.mascot-bounce-target {
    transition: scale var(--duration-emphasis) ease-out;
}
.mascot-bounce-up {
    scale: 1.1 1.1;
}
.mascot-bounce-down {
    scale: 1 1;
}

/* 페이지 전환 fade — UIDocument cross-scene 부드러움 */
.page-fade-in {
    opacity: 1;
    transition: opacity var(--duration-page) ease-out;
}
.page-fade-out {
    opacity: 0;
}
