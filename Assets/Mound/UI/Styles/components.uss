/* components.uss — Boxy Cozy Components (handoff-derived, 2026-04-30 v3)
 * 좌표계: 390×844 pt
 * 출처: design/handoff/app_onboarding_v2/ui.jsx
 * 컨트롤러가 코드에서 직접 add하는 클래스명 절대 변경 금지:
 *   btn-primary, btn-secondary, btn-ghost, popup-overlay, popup-card,
 *   popup-title, popup-body, level-button, level-button-locked,
 *   level-button-current, level-button-unlocked
 */

/* === Pretendard 폰트 적용 — .otf 직접 참조 (SDF asset 안 만들었음) === */
.boxy-root,
.bg-cozy {
    -unity-font: url("project://database/Assets/Mound/UI/Fonts/Pretendard-Regular.otf");
}

Label, Button {
    -unity-font: url("project://database/Assets/Mound/UI/Fonts/Pretendard-Regular.otf");
}

/* ────────── Buttons ────────── */

/* Primary CTA (시작/계속/구매 등) — 56pt 높이, accent orange */
.btn-primary {
    height: 56px;
    background-color: #F59E4B;
    color: #FFFFFF;
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: -0.2px;
    border-radius: 10px;
    border-width: 0;
    padding-left: 16px;
    padding-right: 16px;
    -unity-text-align: middle-center;
    transition: scale 100ms ease-out;
}

.btn-primary:hover {
    scale: 0.99 0.99;
}

.btn-primary:active {
    scale: 0.98 0.98;
    background-color: #E08938;
}

.btn-primary:disabled {
    opacity: 0.5;
}

/* Secondary — 48pt, transparent + orange border */
.btn-secondary {
    height: 48px;
    background-color: rgba(0, 0, 0, 0);
    color: #F59E4B;
    font-size: 16px;
    -unity-font-style: bold;
    border-radius: 10px;
    border-width: 2px;
    border-color: #F59E4B;
    padding-left: 16px;
    padding-right: 16px;
    -unity-text-align: middle-center;
}

.btn-secondary:hover {
    background-color: #FFE4C8;
}

/* Ghost — 44pt, transparent text-only (이어하기, 닫기 등) */
.btn-ghost {
    height: 44px;
    background-color: rgba(0, 0, 0, 0);
    color: #8B6F5C;
    font-size: 15px;
    -unity-font-style: normal;
    border-width: 0;
    -unity-text-align: middle-center;
}

.btn-ghost:hover {
    color: #3D2B1F;
}

/* Icon Button — 44×44 round (settings/shop/back/pause 등) */
.btn-icon {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background-color: #FFFFFF;
    border-width: 1px;
    border-color: #F0E0CC;
    -unity-text-align: middle-center;
    padding: 0;
}

.btn-icon-sm {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: #FFFFFF;
    border-width: 1px;
    border-color: #F0E0CC;
    padding: 0;
}

/* ────────── Cards & Surfaces ────────── */

/* Card 래퍼 — 2-layer warm shadow는 자식 VisualElement로 */
.card {
    background-color: #FFFFFF;
    border-radius: 16px;
    border-width: 1px;
    border-color: #F0E0CC;
    padding: 16px;
}

/* Card 그림자 base layer (Card 위 absolute로 배치) */
.card-shadow {
    background-color: rgba(160, 90, 40, 0.10);
    border-radius: 16px;
    translate: 0 3px;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* ────────── Pills / Badges ────────── */

.pill {
    height: 30px;
    border-radius: 999px;
    background-color: #FFE4C8;
    color: #F59E4B;
    font-size: 13px;
    -unity-font-style: bold;
    padding-left: 12px;
    padding-right: 12px;
    -unity-text-align: middle-center;
    flex-direction: row;
    align-items: center;
}

.pill-outline {
    background-color: #FFFFFF;
    border-width: 1px;
    border-color: #F0E0CC;
}

/* ────────── Topbar (sticky) ────────── */

.topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    padding: 14px 16px 14px 16px;
    background-color: #FFF6EC;
    border-bottom-width: 1px;
    border-bottom-color: #F0E0CC;
}

.topbar-title {
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: -0.3px;
    color: #3D2B1F;
    -unity-text-align: middle-center;
    flex-grow: 1;
}

/* ────────── Mascot Frame ────────── */

.mascot-frame {
    background-color: #FFFFFF;
    border-radius: 28px;
    border-width: 1px;
    border-color: #F0E0CC;
    padding: 0 14px 4px 14px;
    align-items: center;
    justify-content: flex-end;
}

/* peach radial은 USS에서 grad 미지원 → bg image로 대체 (placeholder solid) */
.mascot-frame-bg {
    background-color: #FFE4C8;
    border-radius: 28px;
    align-items: center;
    justify-content: flex-end;
    padding: 0 14px 4px 14px;
}

/* ────────── Modal Overlay (popup) ────────── */

.popup-overlay {
    background-color: rgba(61, 43, 31, 0.65);
    align-items: center;
    justify-content: center;
    padding: 20px;
    flex-grow: 1;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.popup-card {
    width: 100%;
    background-color: #FFFFFF;
    border-radius: 22px;
    padding: 24px 22px 22px 22px;
}

.popup-title {
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: -0.8px;
    color: #3D2B1F;
    -unity-text-align: middle-center;
}

.popup-body {
    font-size: 14px;
    color: #8B6F5C;
    -unity-text-align: middle-center;
    margin-top: 6px;
    white-space: normal;
}

/* ────────── Level Select Grid (controller-managed classes) ────────── */

.level-button {
    background-color: #FFFFFF;
    border-radius: 14px;
    border-width: 1px;
    border-color: #F0E0CC;
    -unity-font-style: bold;
    color: #3D2B1F;
    font-size: 22px;
    align-items: center;
    justify-content: center;
}

.level-button-locked {
    opacity: 0.55;
}

.level-button-current {
    border-width: 3px;
    border-color: #F59E4B;
}

.level-button-unlocked {
    /* 기본 상태 + done 별 표시는 controller에서 처리 */
}

/* ────────── Onboarding step dots ────────── */

.step-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: #F0E0CC;
    margin-left: 4px;
    margin-right: 4px;
    transition: width 250ms ease-out;
}

.step-dot-active {
    width: 24px;
    background-color: #F59E4B;
}

/* ────────── Settings row ────────── */

.settings-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 56px;
    padding: 0 4px 0 4px;
}

.settings-row-label {
    font-size: 16px;
    color: #3D2B1F;
    flex-grow: 1;
}

.settings-section-header {
    font-size: 13px;
    -unity-font-style: bold;
    color: #8B6F5C;
    margin-top: 16px;
    margin-bottom: 8px;
    letter-spacing: 0.5px;
}

.divider {
    height: 1px;
    background-color: #F0E0CC;
    margin-top: 4px;
    margin-bottom: 4px;
}

/* ────────── Progress Bar ────────── */

.progress-bg {
    height: 6px;
    background-color: #F0E0CC;
    border-radius: 3px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background-color: #F59E4B;
    border-radius: 3px;
}

/* ────────── Wordmark (Boxy 로고 텍스트) ────────── */

.wordmark {
    font-size: 48px;
    -unity-font-style: bold;
    letter-spacing: -1.8px;
    color: #3D2B1F;
    -unity-text-align: middle-center;
}

/* ────────── Tab bar (Level Select 테마) ────────── */

.theme-tab {
    flex-grow: 1;
    height: 48px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0);
    color: #8B6F5C;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.theme-tab-active {
    color: #F59E4B;
    border-bottom-color: #F59E4B;
}
